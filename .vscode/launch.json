{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Jobble (.env)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=.env"]
    },
    {
      "name": "Jobble (Railway)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define=API_BASE_URL=https://jobble-api.up.railway.app"
      ]
    },
    {
      "name": "Jobble (backend local — simulador iOS)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=API_BASE_URL=http://localhost:3333"]
    },
    {
      "name": "Jobble (backend local — emulador Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define=API_BASE_URL=http://10.0.2.2:3333"]
    },
    {
      "name": "Jobble (.env, release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=.env"]
    }
  ]
}
