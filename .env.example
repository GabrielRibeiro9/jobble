# Configuração de ambiente do app Flutter.
# Copie para `.env` (que fica fora do Git) e ajuste conforme o alvo.
#
# Estas variáveis são injetadas como `--dart-define` em tempo de compilação
# por `scripts/run.sh` / `scripts/build.sh` e pelas configs do VS Code.
# Depois de alterar qualquer valor é preciso reiniciar o app (hot reload não pega).

# URL base da API, sem barra no final.
#   Railway (produção): https://jobble-api.up.railway.app
#   Backend local + simulador iOS:   http://localhost:3333
#   Backend local + emulador Android: http://10.0.2.2:3333
API_BASE_URL=https://jobble-api.up.railway.app

# URL base dos arquivos enviados (fotos de perfil e portfólio).
# Deixe em branco para usar automaticamente $API_BASE_URL/uploads.
UPLOADS_BASE_URL=

# Timeouts do Dio, em segundos.
API_CONNECT_TIMEOUT_SECONDS=10
API_RECEIVE_TIMEOUT_SECONDS=15

# Log de request/response HTTP no console. Default: ligado em debug, desligado em release.
ENABLE_HTTP_LOGS=true
